---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Wordmark from "@/components/Wordmark.astro";
---

<BaseLayout title="Not found · Jack Hric" noindex>
  <Nav />
  <main class="flex-1 grid place-items-center px-4 pt-[var(--nav-h)]">
    <div class="grain grain-fine grain-3 border border-brutal-accent/30 bg-black/90 p-8 flex flex-col items-center gap-4 text-center">
      <p class="font-mono text-sm tracking-[0.25em] uppercase text-white/40">404</p>
      <h1 class="text-5xl text-white"><Wordmark text="Nothing here" /></h1>
      <p class="text-white/60">That page doesn't exist on jackhric.github.io.</p>
      <a
        href="/"
        class="font-mono text-xs tracking-[0.2em] uppercase px-3 py-2 border-2 border-white/20 text-white/80 hover:border-brutal-accent hover:text-brutal-accent outline-none focus-visible:border-brutal-accent"
        >All projects</a
      >
    </div>
  </main>
</BaseLayout>
