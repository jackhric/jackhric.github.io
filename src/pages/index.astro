---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import Nav from "@/components/Nav.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Wordmark from "@/components/Wordmark.astro";
import { projects } from "@/data/projects";
import { GITHUB_URL, PORTFOLIO_URL } from "@/data/site";
---

<BaseLayout>
  <Nav />

  <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 pt-[calc(var(--nav-h)+1.5rem)] pb-6 md:pt-[calc(var(--nav-h)+3rem)]">
    <div class="grain grain-fine grain-3 bg-black/90 border border-brutal-accent/30 p-5 md:p-8">
      <a
        href={PORTFOLIO_URL}
        data-glow
        data-umami-event="outbound-portfolio"
        data-umami-event-from="hero"
        class="enter grain grain-finer grain-5 group flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-8 border border-brutal-accent/30 bg-brutal-accent/10 p-4 md:p-5 text-brutal-accent outline-none hover:bg-brutal-accent/15 focus-visible:border-brutal-accent"
      >
        <span aria-hidden="true" data-glow-ring></span>
        <span class="flex flex-col gap-3">
          <span class="font-mono text-xs tracking-[0.2em] uppercase flex items-center gap-2">
            <span class="inline-block size-2 bg-brutal-accent animate-pulse"></span>
            Looking for my portfolio?
          </span>
          <Wordmark text="jackhric.com" class="text-3xl md:text-4xl text-white group-hover:text-brutal-accent" />
        </span>
        <span class="flex items-center justify-between gap-4 md:justify-end">
          <span class="text-sm text-white/60">Work history, résumé and contact all live there.</span>
          <Icon name="arrow" class="size-6 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </span>
      </a>

      <section class="mt-8 md:mt-10 border-t border-white/10 pt-4">
        <div class="flex items-baseline justify-between gap-4 mb-3">
          <h1 class="text-lg text-white/60"><span class="sr-only">Jack Hric · Open source </span>Projects</h1>
          <span class="font-mono text-xs tracking-[0.25em] text-white/30 tabular-nums">
            {String(projects.length).padStart(2, "0")}
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {projects.map((project, i) => <ProjectCard project={project} delay={60 + i * 40} />)}
        </div>
      </section>
    </div>
  </main>

  <footer
    class="flex flex-wrap items-center justify-end gap-x-6 gap-y-2 px-4 py-2 font-mono text-[10px] text-brutal-accent tracking-[0.25em] uppercase"
  >
    <span class="flex gap-6">
      <a href={PORTFOLIO_URL} class="hover:text-white focus-visible:text-white outline-none">jackhric.com</a>
      <a href={GITHUB_URL} rel="me" class="hover:text-white focus-visible:text-white outline-none">github.com/jackhric</a>
    </span>
  </footer>
</BaseLayout>
