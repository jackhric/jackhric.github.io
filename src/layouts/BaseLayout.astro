---
import "@/styles/global.css";
import LavaBackground from "@/components/LavaBackground.astro";
import Fonts from "./head/Fonts.astro";
import Statistics from "./head/Statistics.astro";
import { SITE_URL } from "@/data/site";

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Jack Hric · Open source",
  description = "Open source projects by Jack Hric, each with its own site. His portfolio is at jackhric.com.",
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Fonts />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="y-n-BgnSmhrLWJW-WwHWAPgbUNZx1RdIDWPKwVbC3kA" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="me" href="https://jackhric.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <Statistics />
  </head>
  <body class="min-h-dvh flex flex-col">
    <LavaBackground />
    <slot />
    <script>
      import { mountPointerGlow } from "@/lib/pointer-glow";
      mountPointerGlow(document.body);
    </script>
  </body>
</html>
